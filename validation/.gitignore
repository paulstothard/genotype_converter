# Keep the validation instructions and placeholder directories in git.
!README.md
!.gitignore
!.gitkeep
!*/.gitkeep

# Real validation data and generated outputs can be large or sensitive.
.DS_Store
data/*
old_pipeline/*
new_pipeline/*
reports/*
mixed_manifest/sources/*/manifests/*
mixed_manifest/sources/*/references/*/*
mixed_manifest/sources/*/genotypes/*
mixed_manifest/database_build/*
mixed_manifest/converted/*
mixed_manifest/reports/*
mixed_manifest/*.sqlite
mixed_manifest/*.sqlite3
mixed_manifest/*.sqlite-journal
mixed_manifest/*.sqlite3-journal
mixed_manifest/temp-dont-commit/
plink_comparison/input/*
plink_comparison/converted/*
plink_comparison/reports/*

# Allow directory placeholders.
!data/.gitkeep
!old_pipeline/.gitkeep
!new_pipeline/.gitkeep
!reports/.gitkeep
!mixed_manifest/README.md
!mixed_manifest/**/.gitkeep
!plink_comparison/README.md
!plink_comparison/scripts/**
!plink_comparison/**/.gitkeep
plink_comparison/scripts/__pycache__/
